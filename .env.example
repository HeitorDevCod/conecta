# Copie para .env e ajuste os valores antes de subir em produção.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:8080

# PostgreSQL
POSTGRES_DB=conecta
POSTGRES_USER=conecta
POSTGRES_PASSWORD=conecta-dev-password
DATABASE_URL=postgres://conecta:conecta-dev-password@db:5432/conecta

# Contas e e-mail
# Endereço do site usado nos links de confirmação e de redefinição de senha
FRONTEND_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=true
# No Docker os e-mails vão para o Mailpit (http://localhost:8025).
# Em produção, use o SMTP do seu provedor (ex.: Brevo, SendGrid, Amazon SES, Gmail):
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Conecta <nao-responda@seudominio.com>

# Redis (channel layer + presença)
REDIS_URL=redis://redis:6379/0

# WebRTC
STUN_URLS=stun:stun.l.google.com:19302
# Ative o serviço "turn" (docker compose --profile turn up) e preencha abaixo
TURN_URLS=
TURN_USERNAME=conecta
TURN_CREDENTIAL=troque-esta-senha
CALL_MAX_PARTICIPANTS=6
